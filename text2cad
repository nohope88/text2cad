def telegram_send_text(text: str) -> None:
    tok = os.environ.get("TELEGRAM_BOT_TOKEN", "").strip()
    chat = os.environ.get("TELEGRAM_CHAT_DM", "").strip()
    if tok and chat:
        subprocess.run(["curl", "-s", f"https://api.telegram.org/bot{tok}/sendMessage",
                        "-d", f"chat_id={chat}", "--data-urlencode", f"text={text}"],
                       capture_output=True, timeout=30)


def telegram_send_proposal(out_dir: Path, slug: str) -> str:
    tok = os.environ.get("TELEGRAM_BOT_TOKEN", "").strip()
    chat = os.environ.get("TELEGRAM_CHAT_DM", "").strip()
    hero = out_dir / "hero.png"
    parts = out_dir / "parts.png"
    if not (tok and chat and hero.is_file()):
        return "telegram: skipped (no creds or no renders)"
    cap = f"text2cad PROPOSAL: {slug}\nGO:  ./text2cad {slug} --go\nNO:  ./text2cad {slug} --reject 'reason'"
    for img, c in ((hero, cap), (parts, "parts breakdown")):
        if img.is_file():
            subprocess.run(["curl", "-s", f"https://api.telegram.org/bot{tok}/sendPhoto",
                            "-F", f"chat_id={chat}", "-F", f"photo=@{img}", "-F", f"caption={c}"],
                           capture_output=True, timeout=60)
    return "telegram: proposal sent"


def telegram_send_photo(img: Path, caption: str) -> None:
    tok = os.environ.get("TELEGRAM_BOT_TOKEN", "").strip()
    chat = os.environ.get("TELEGRAM_CHAT_DM", "").strip()
    if tok and chat and img.is_file():
        subprocess.run(["curl", "-s", f"https://api.telegram.org/bot{tok}/sendPhoto",
                        "-F", f"chat_id={chat}", "-F", f"photo=@{img}",
                        "-F", f"caption={caption}"], capture_output=True, timeout=60)


def hero_render(slug: str, out_dir: Path) -> Path | None:
    rd = out_dir / f"{slug}_review"
    if not rd.is_dir():
        return None
    pngs = sorted(rd.glob("*.png"), key=lambda p: p.stat().st_mtime)
    for p in reversed(pngs):
        if "hero" in p.name or "assembled" in p.name:
            return p
    return pngs[-1] if pngs else None


def repair_prompt(slug: str, out_dir: Path, fails: list) -> str:
    gate_cmd = f"{VENV_PY} {GATE_PY} {out_dir}"
    return f"""{HEADLESS_WARNING}

You are a REPAIR session of a text-to-CAD pipeline, in `{out_dir}`. Previous
sessions left this part FAILING its printability gate: {fails}.{lessons_block()}

0. Read `panel_history.json` (every prior panel verdict, oldest -> newest) and
   the current `review_*.md` files FIRST. Treat prior verdicts as a REGRESSION
   SUITE: past repair rounds oscillated — each fixed its named fail while
   quietly re-breaking a feature an earlier round had already accepted. A fix
   that re-breaks a previously-PASSed lens or re-opens an old finding is worse
   than no fix.
1. Read `gate.json`, `params.py`, `main.py`, `{HERE}/blocks/BLOCKS.md` (prefer
   swapping broken hand-built geometry for a verified golden block), and
   `{CADCODE}/SKILL.md` (the sections on booleans/validation). Diagnose the
   ROOT CAUSE in the code —
   e.g. multiple bodies usually means unioned pieces only touch tangentially
   or don't overlap; make every piece OVERLAP its neighbor by >= 1mm and fuse
   with a single union chain into ONE solid.
2. Fix the code. Do NOT redesign the product; change geometry construction only.
3. Re-export with the cad tool (`{CAD_CMD}`), re-run the gate (`{gate_cmd}`),
   and iterate SYNCHRONOUSLY until the gate prints GATE PASS.
4. Append ONE short durable lesson to `{HERE}/lessons.md` (create if missing):
   a rule that would have PREVENTED this failure class in a future build,
   written as an imperative (e.g. "- Always ...").

Reply with ONE line: `REPAIRED` or `STUCK <reason>`. IMPORTANT: if your
diagnosis is that the failure traces to `brief.md` itself demanding something
impossible (numbers that cannot coexist geometrically, physically, or with
each other), do NOT fake a workaround — reply `STUCK spec-conflict: <the
impossibility in one sentence>` so the pipeline goes straight to arbitration
instead of burning more repair rounds."""


def arbitration_prompt(slug: str, out_dir: Path, fails: list) -> str:
    return f"""{HEADLESS_WARNING}

You are the ARBITRATION phase of a text-to-CAD pipeline, in `{out_dir}`.
The repair budget is exhausted and the part still fails: {fails}.
Your job: decide whether what remains is a genuine SPEC CONFLICT — brief.md
demanding things that are mutually impossible (geometrically, physically, or
against its own other numbers) — as opposed to a build defect or reviewer
noise. Repair sessions may have left their diagnosis in `params.py` comments
and their replies; weigh those.

1. Read `brief.md`, `gate.json`, `params.py`, `main.py`, every
   `review_*.md`, and the renders in `{slug}_review/`.
2. WRITE EARLY: the moment you have decided, write `arbitration.md` — its
   FIRST line must be EXACTLY `Verdict: PROPOSE <one-sentence summary>` or
   `Verdict: NO-CONFLICT <reason>` — then the conflict in one paragraph, the
   changed numbers as a short before → after list, and what the change trades
   away. The pipeline falls back to that first line if this session dies
   before replying; a session that ends without `arbitration.md` is lost.
3. If the remaining fails are NOT a spec conflict (fixable defect, or the
   lens verdict looks wrong), write no other file and reply
   `NO-CONFLICT <reason>`.
4. If they ARE a spec conflict: write `brief_proposed.md` — the FULL amended
   brief, changing the MINIMUM set of numbers that resolves the conflict,
   with an `## Amendments` section at the end stating each change and why.
   NEVER relax safety-critical requirements (viewing safety, min walls,
   watertightness) and NEVER exceed the user's stated envelope. Do NOT touch
   `brief.md` itself — the human applies the proposal.

Reply with ONE line: `PROPOSE <one-sentence summary>` or `NO-CONFLICT <reason>`."""


TIER_BUDGET = {"broken": 2, "functional": 3, "cosmetic": 2}


def fail_tier(fails: list) -> str:
    """Circuit-style severity tiers: worst tier present decides the repair budget."""
    fl = " ".join(map(str, fails or []))
    if any(k in fl for k in ("not_watertight", "bodies=", "no_stl", "lint:")):
        return "broken"
    if any(k in fl for k in ("print_time=", "slice_failed", "overhang=", "lens:printability", "lens:fidelity")):
        return "functional"
    return "cosmetic"


def run_arbitration(slug: str, out_dir: Path, fails: list, tier: str,
                    spent_n: int, run_log: dict) -> None:
    """Run the arbitration phase; falls back to arbitration.md's first
    `Verdict:` line (mtime-guarded, like lens_verdict) when stdout is empty —
    the phase can die at max_turns with its verdict only on disk."""
    arb_file = out_dir / "arbitration.md"
    arb_mtime = arb_file.stat().st_mtime if arb_file.is_file() else None
    arb = run_phase("arbitration", arbitration_prompt(slug, out_dir, fails),
                    out_dir, 50, run_log, timeout_s=3600)
    last = (arb or "").strip().splitlines()[-1] if (arb or "").strip() else ""
    if not last.startswith(("PROPOSE", "NO-CONFLICT")) and arb_file.is_file() \
            and (arb_mtime is None or arb_file.stat().st_mtime > arb_mtime):
        first = arb_file.read_text(encoding="utf-8").strip().splitlines()[0]
        if first.lower().startswith("verdict:"):
            last = first.partition(":")[2].strip()
    if last.startswith("PROPOSE") and (out_dir / "brief_proposed.md").is_file():
        msg = (f"ARBITRATION: {slug} — spec conflict after {spent_n} repairs: "
               f"{last[len('PROPOSE'):].strip()}\n"
               f"details: {out_dir}/arbitration.md\n"
               f"GO:  ./text2cad {slug} --amend\n"
               f"NO:  rm {out_dir}/brief_proposed.md")
        run_log.pop("escalated", None)
        run_log["arbitrated"] = {"tier": tier, "fails": fails, "proposal": last}
    else:
        msg = (f"ESCALATE: {slug} — {tier} tier budget exhausted "
               f"({spent_n} repairs), still failing: {fails}")
        run_log.pop("arbitrated", None)
        run_log["escalated"] = {"tier": tier, "fails": fails}
    print(msg)
    telegram_send_text(msg)


def run_gate(out_dir: Path, no_slice: bool) -> dict:
    gate = subprocess.run([str(VENV_PY), str(GATE_PY), str(out_dir)]
                          + (["--no-slice"] if no_slice else []),
                          capture_output=True, text=True)
    print(gate.stdout.strip())
    return json.loads((out_dir / "gate.json").read_text(encoding="utf-8"))


def main() -> int:
    ap = argparse.ArgumentParser(description="text prompt -> printable .step/.stl")
    ap.add_argument("prompt", nargs="?", default="",
                    help='prompt, or slug of existing out/<slug> with --repair/--go/--reject')
    ap.add_argument("--slug", help="output folder name (default: from prompt)")
    ap.add_argument("--no-slice", action="store_true", help="mesh-only gate")
    ap.add_argument("--repair", action="store_true",
                    help="skip brief/build/review; gate + repair-loop an existing out/<slug>")
    ap.add_argument("--amend", action="store_true",
                    help="apply out/<slug>/brief_proposed.md from arbitration, then re-review")
    ap.add_argument("--arbitrate", action="store_true",
                    help="re-run only the arbitration phase on an escalated out/<slug>")
    ap.add_argument("--review", action="store_true",
                    help="skip brief/build; review + gate + repair-loop an existing out/<slug>")
    ap.add_argument("--max-repairs", type=int, default=3)
    ap.add_argument("--discover", action="store_true",
                    help="trend scan -> 3 scored candidates -> pick 1 -> brief -> draft renders -> STOP for human")
    ap.add_argument("--auto", action="store_true",
                    help="with --discover: do not stop at the proposal — continue straight into build (full-auto)")
    ap.add_argument("--go", action="store_true",
                    help="human approved the proposal: full build from existing brief + draft")
    ap.add_argument("--reject", metavar="REASON",
                    help="human rejected the proposal: record lesson for future discovery")
    args = ap.parse_args()

    load_env()

    if args.amend:
        args.review = True

    if args.reject:
        slug = args.slug or args.prompt
        f = HERE / "discover_lessons.md"
        header = "" if f.is_file() else "# discover lessons (human GO/REJECT feedback)\n\n"
        with f.open("a", encoding="utf-8") as fh:
            fh.write(f"{header}- REJECTED '{slug}': {args.reject}\n")
        print(f"lesson recorded. re-run --discover for a new proposal.")
        return 0

    if args.discover:
        trend_dir = Path(os.environ.get("TREND_DIR", str(Path.home() / "brain" / "raw")))
        source = os.environ.get("TREND_SOURCE", "files" if trend_dir.is_dir() else "mcp")
        trends = [] if source == "mcp" else \
            sorted(trend_dir.glob("*-x-scrape.md"))[-1:] + \
            sorted(trend_dir.glob("*-hn-morning.md"))[-1:]
        if source != "mcp" and not trends:
            print(f"no trend files in {trend_dir} — falling back to second-brain MCP")
        tmp = HERE / "out" / "_discover"
        tmp.mkdir(parents=True, exist_ok=True)
        run_log = {"mode": "discover", "trends": [str(t) for t in trends] or ["second-brain-mcp"]}
        print(f"== text2cad discover: trends={[t.name for t in trends] or 'second-brain MCP'}")
        run_phase("discover", discover_prompt(tmp, trends), tmp, 25, run_log, timeout_s=2400)
        disc = tmp / "discover.md"
        if not disc.is_file():
            print("ABORT: discover.md not produced"); return 1
        text = disc.read_text(encoding="utf-8")
        m = re.search(r"^WINNER:\s*([a-z0-9-]+)", text, re.M)
        p = re.search(r"^PROMPT:\s*(.+)$", text, re.M)
        if not m:
            print("ABORT: no WINNER line in discover.md"); return 1
        slug = m.group(1)[:40]
        out_dir = HERE / "out" / slug
        out_dir.mkdir(parents=True, exist_ok=True)
        (out_dir / "discover.md").write_text(text, encoding="utf-8")
        run_log["slug"] = slug
        product_prompt = p.group(1).strip() if p else slug.replace("-", " ")
        run_log["prompt"] = product_prompt

        run_phase("brief", brief_prompt(product_prompt, out_dir), out_dir, 16, run_log, timeout_s=1800)
        if not (out_dir / "brief.md").is_file():
            print("ABORT: brief.md was not produced"); return 1
        run_phase("draft", draft_prompt(slug, out_dir), out_dir, 45, run_log, timeout_s=3600)
        rd = out_dir / f"{slug}_review"
        for src, dst in ((rd / "_assembled.png", "hero.png"), (rd / "_qa.png", "parts.png")):
            if src.is_file():
                (out_dir / dst).write_bytes(src.read_bytes())
        ref = out_dir / "reference"
        ref.mkdir(exist_ok=True)
        for png in rd.glob("*.png"):
            (ref / png.name).write_bytes(png.read_bytes())
        print(f"reference set: {len(list(ref.glob('*.png')))} approved renders for the build phase")
        print(telegram_send_proposal(out_dir, slug))
        (out_dir / "run.json").write_text(json.dumps(run_log, indent=2), encoding="utf-8")
        total = sum(e.get("cost_usd") or 0 for e in run_log.values() if isinstance(e, dict) and "cost_usd" in e)
        print(f"\n== PROPOSAL READY: {slug} (${total:.2f})")
        print(f"   preview: {out_dir}/hero.png + parts.png | scores: {out_dir}/discover.md")
        if not args.auto:
            print(f"   GO: ./text2cad {slug} --go   |   NO: ./text2cad {slug} --reject 'reason'")
            return 0
        # full-auto: proposal is FYI only — continue straight into the build path
        print("   AUTO mode: continuing into build")
        args.go, args.prompt, args.slug = True, slug, slug
    if args.repair or args.review or args.go or args.arbitrate:
        slug = args.slug or args.prompt
    else:
        slug = args.slug or re.sub(r"[^a-z0-9]+", "-", args.prompt.lower()).strip("-")[:40]
    out_dir = HERE / "out" / slug
    verdict = ""

    if args.arbitrate:
        run_log = json.loads((out_dir / "run.json").read_text(encoding="utf-8")) \
            if (out_dir / "run.json").is_file() else {"slug": slug}
        prior = run_log.get("escalated") or run_log.get("arbitrated") or {}
        fails = prior.get("fails") or ["unknown"]
        tier = prior.get("tier") or fail_tier(fails)
        print(f"== text2cad arbitrate: {slug} -> {out_dir}")
        run_arbitration(slug, out_dir, fails, tier, TIER_BUDGET[tier], run_log)
        (out_dir / "run.json").write_text(json.dumps(run_log, indent=2), encoding="utf-8")
        return 0

    if args.repair or args.review:
        if not list(out_dir.glob("*.stl")):
            print(f"ABORT: no .stl in {out_dir} to repair"); return 1
        run_log = json.loads((out_dir / "run.json").read_text(encoding="utf-8")) \
            if (out_dir / "run.json").is_file() else {"slug": slug}
        if args.amend:
            prop = out_dir / "brief_proposed.md"
            if not prop.is_file():
                print(f"ABORT: no brief_proposed.md in {out_dir} — nothing to amend"); return 1
            (out_dir / "brief.md").write_text(prop.read_text(encoding="utf-8"), encoding="utf-8")
            prop.unlink()
            print("brief.md amended from arbitration proposal")
        print(f"== text2cad {'review' if args.review else 'repair'}: {slug} -> {out_dir}")
    else:
        out_dir.mkdir(parents=True, exist_ok=True)
        if args.go:
            if not (out_dir / "brief.md").is_file():
                print(f"ABORT: no brief.md in {out_dir} — run --discover first"); return 1
            run_log = json.loads((out_dir / "run.json").read_text(encoding="utf-8")) \
                if (out_dir / "run.json").is_file() else {"slug": slug}
            print(f"== text2cad GO (human-approved): {slug} -> {out_dir}")
        else:
            run_log = {"prompt": args.prompt, "slug": slug}
            print(f"== text2cad: {slug} -> {out_dir}")

            run_phase("brief", brief_prompt(args.prompt, out_dir), out_dir, 16, run_log, timeout_s=1800)
            if not (out_dir / "brief.md").is_file():
                print("ABORT: brief.md was not produced"); return 1

        run_phase("build", build_prompt(slug, out_dir), out_dir, 120, run_log, timeout_s=10800)
        if not list(out_dir.glob("*.stl")):
            print("ABORT: no .stl produced"); return 1

    run_log["gate"] = run_gate(out_dir, args.no_slice)

    lens_fails = []
    if not args.repair:
        run_log["panel"] = run_panel(slug, out_dir, run_log)
        lens_fails = [f"lens:{k} {v}" for k, v in run_log["panel"].items()
                      if not v.startswith("PASS")]

    spent = {t: 0 for t in TIER_BUDGET}
    attempt = 0
    bonus_granted = False
    while not (run_log["gate"].get("pass") and not lens_fails):
        fails = (run_log["gate"].get("fails") or []) + lens_fails or ["unknown"]
        tier = fail_tier(fails)
        if spent[tier] >= TIER_BUDGET[tier] + (1 if bonus_granted else 0):
            run_arbitration(slug, out_dir, fails, tier, spent[tier], run_log)
            break
        if spent[tier] >= TIER_BUDGET[tier]:
            if not scores_improving(out_dir):
                run_arbitration(slug, out_dir, fails, tier, spent[tier], run_log)
                break
            bonus_granted = True
            telegram_send_text(f"{slug}: budget exhausted but failing lens scores "
                               f"still climbing — granting 1 bonus repair")
        spent[tier] += 1
        attempt += 1
        verdict = run_phase(f"repair{attempt}",
                            repair_prompt(slug, out_dir, fails) +
                            f"\nSeverity tier: {tier.upper()} (attempt {spent[tier]}/{TIER_BUDGET[tier]} for this tier).",
                            out_dir, 50, run_log, timeout_s=5400)
        stuck = (verdict or "").strip().splitlines()[-1] if (verdict or "").strip() else ""
        if stuck.startswith("STUCK"):
            # repair declared itself stuck — skip the remaining repair budget
            # and let arbitration decide (it telegrams GO/NO if spec conflict)
            run_arbitration(slug, out_dir, fails + [f"repair{attempt}: {stuck}"],
                            tier, spent[tier], run_log)
            break
        run_log["gate"] = run_gate(out_dir, args.no_slice)
        if lens_fails:  # change-only rescore: re-run failed lenses, keep passed verdicts
            failed = [k for k in run_log["panel"] if not run_log["panel"][k].startswith("PASS")]
            run_log["panel"] = run_panel(slug, out_dir, run_log, lenses=failed)
            lens_fails = [f"lens:{k} {v}" for k, v in run_log["panel"].items()
                          if not v.startswith("PASS")]
        hero = hero_render(slug, out_dir)
        if hero:
            panel = run_log.get("panel") or {}
            telegram_send_photo(hero, f"{slug} repair{attempt}: " + (" ".join(
                f"{k}:{' '.join(str(v).split()[:2])}" for k, v in panel.items())
                or f"gate={'PASS' if run_log['gate'].get('pass') else 'FAIL'}"))

    panel = run_log.get("panel") or {}
    verdict = ("PANEL " + " ".join(f"{k}:{'PASS' if v.startswith('PASS') else 'FAIL'}"
               for k, v in panel.items())) if panel else (verdict or "")
    (out_dir / "run.json").write_text(json.dumps(run_log, indent=2), encoding="utf-8")

    files = [p.name for p in sorted(out_dir.iterdir()) if p.suffix in (".step", ".stl", ".md", ".json")]
    total = sum(e.get("cost_usd") or 0 for e in run_log.values() if isinstance(e, dict) and "cost_usd" in e)
    print(f"\n== DONE {slug}: gate={'PASS' if run_log['gate'].get('pass') else 'FAIL'} "
          f"| {verdict.splitlines()[-1] if verdict else '?'}")
    print(f"   files: {files}")
    print(f"   total LLM cost: ${total:.4f}  (details: {out_dir}/run.json)")
    return 0


if __name__ == "__main__":
    sys.exit(main())
