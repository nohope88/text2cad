def lens_prompt(slug: str, out_dir: Path, lens: str) -> str:
    return f"""{HEADLESS_WARNING}

You are ONE independent lens of a review panel for the part in `{out_dir}`.
Other lenses run separately — judge NOTHING outside your lens.

YOUR LENS — {lens.upper()}: {LENSES[lens]}

Read `brief.md`, `gate.json`, and EVERY render in `{slug}_review/` (re-render
with `{REVIEW_CMD}` if none exist). Do NOT edit part files — verdict only.
Write `review_{lens}.md`: its FIRST line must be `Verdict: PASS <score>/10`
or `Verdict: FAIL <score>/10 <one-sentence reason>` — <score> grades how close
the part is to passing YOUR lens (10 = flawless, 8 = minimum pass, one decimal
ok); findings below. Write the file as soon as you have a verdict — never
leave it for a final turn you may not get.

Reply with ONE line: `PASS <score>/10` or `FAIL <score>/10 <one-sentence reason>`."""


def lens_verdict(out_dir: Path, lens: str, reply: str, mtime_before) -> str:
    """Reply's last line; else fall back to the Verdict: line in the lens's
    review_<lens>.md — but only if the file was (re)written by THIS lens run
    (mtime check), so a stale file from an earlier run can't vote."""
    last = (reply or "").strip().splitlines()[-1] if (reply or "").strip() else ""
    if last.startswith(("PASS", "FAIL")):
        return last
    f = out_dir / f"review_{lens}.md"
    if f.is_file() and (mtime_before is None or f.stat().st_mtime > mtime_before):
        m = re.search(r"Verdict\W{0,4}(PASS|FAIL)\b\W{0,3}(.*)", f.read_text(encoding="utf-8"), re.I)
        if m:
            return (m.group(1).upper() + " " + m.group(2).strip().strip("*")).strip()
    return "FAIL no output"


def lens_score(verdict: str) -> float | None:
    m = re.search(r"(\d+(?:\.\d+)?)\s*/\s*10", verdict or "")
    return float(m.group(1)) if m else None


def scores_improving(out_dir: Path) -> bool:
    """True when every still-failing lens scored strictly higher in the last
    panel round than the round before — grounds for one bonus repair."""
    try:
        hist = json.loads((out_dir / "panel_history.json").read_text(encoding="utf-8"))
    except Exception:
        return False
    if len(hist) < 2:
        return False
    prev, cur = hist[-2], hist[-1]
    failing = [k for k, v in cur.items() if not v.startswith("PASS")]
    pairs = [(lens_score(prev.get(k)), lens_score(cur.get(k))) for k in failing]
    return bool(pairs) and all(a is not None and b is not None and b > a for a, b in pairs)


def run_panel(slug: str, out_dir: Path, run_log: dict, lenses=None) -> dict:
    """Independent lens sessions, separate contexts (circuit-style panel)."""
    results = dict(run_log.get("panel") or {})
    for lens in (lenses or LENSES):
        f = out_dir / f"review_{lens}.md"
        mtime_before = f.stat().st_mtime if f.is_file() else None
        r = run_phase(f"lens-{lens}", lens_prompt(slug, out_dir, lens), out_dir, 35, run_log, timeout_s=2400)
        results[lens] = lens_verdict(out_dir, lens, r, mtime_before)
    hist_f = out_dir / "panel_history.json"
    try:
        hist = json.loads(hist_f.read_text(encoding="utf-8"))
    except Exception:
        hist = []
    hist.append(results)
    hist_f.write_text(json.dumps(hist, indent=2), encoding="utf-8")
    return results


